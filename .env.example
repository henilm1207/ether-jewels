# Self-hosted MongoDB Community (Hostinger VPS, Ubuntu 24.04).
# Dev (no auth):  mongodb://localhost:27017/etherstar-jewels
# VPS (auth, standalone — keep directConnection=true):
# MONGO_URI=mongodb://etherapp:<APP_PW>@127.0.0.1:27017/etherstar-jewels?authSource=etherstar-jewels&directConnection=true
MONGO_URI=mongodb://localhost:27017/etherstar-jewels
# Base URL used by scripts (verify-local-db) to HTTP-check /uploads images.
# Local default below; on the VPS use https://etherstar.cloud.
PUBLIC_API_BASE=http://localhost:5001
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DB_VIEWER=false

# Admin bootstrap (created automatically on server boot if set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
ADMIN_PHONE=

# Product image uploads (local disk). Files are resized to 1600px max,
# watermarked, and saved as WebP q80 under UPLOADS_DIR (/uploads/*.webp).
# Dev default: server/public/uploads. Production (Hostinger VPS): point at
# the persistent volume, e.g. UPLOADS_DIR=/var/www/etherstar/uploads.
UPLOADS_DIR=

# AI product copywriter (Gemini). If unset, POST /api/ai/describe returns 503.
GEMINI_API_KEY=

# Card payments (Stripe, test mode). Publishable key is public; secret stays server-only.
# Without these, the card option shows "not configured".
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (sandbox first: PAYPAL_MODE=sandbox). Without these, PayPal shows "not configured".
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Outbound mail (Resend, free 3k/mo) — order confirmations + email OTP.
# Without these, mail is skipped and email OTP returns 503.
RESEND_API_KEY=
MAIL_FROM=EtherStar Jewels <orders@example.com>

# WhatsApp OTP (Meta Cloud API: WHATSAPP_TOKEN + number id + approved auth
# template name). Without these, WhatsApp OTP returns 503.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
