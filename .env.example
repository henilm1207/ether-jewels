# Self-hosted MongoDB Community (Hostinger VPS, Ubuntu 24.04).
# Dev (no auth):  mongodb://localhost:27017/etherstar-jewels
# VPS (auth, standalone — keep directConnection=true):
# MONGO_URI=mongodb://etherapp:<APP_PW>@127.0.0.1:27017/etherstar-jewels?authSource=etherstar-jewels&directConnection=true
# docker-compose (see docker-compose.yml): MONGO_URI is overridden there to
# point at the `mongo` service using MONGO_ROOT_USER/MONGO_ROOT_PASSWORD
# below — the value here is only used when running `node server.js` directly.
MONGO_URI=mongodb://localhost:27017/etherstar-jewels

# docker-compose only: credentials for the bundled MongoDB container
# (docker-compose.yml's `mongo` service). Not read by the app directly.
MONGO_ROOT_USER=etherapp
MONGO_ROOT_PASSWORD=
# Base URL used by scripts (verify-local-db) to HTTP-check /uploads images.
# Local default below; on the VPS use https://etherstar.cloud.
PUBLIC_API_BASE=http://localhost:5001
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DB_VIEWER=false

# Admin bootstrap (created automatically on server boot if set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
ADMIN_PHONE=

# Product image uploads (local disk). Files are resized to 1600px max,
# watermarked, and saved as WebP q80 under UPLOADS_DIR (/uploads/*.webp).
# Dev default: server/public/uploads. Production (Hostinger VPS): point at
# the persistent volume, e.g. UPLOADS_DIR=/var/www/etherstar/uploads.
UPLOADS_DIR=

# AI product copywriter (Gemini). If unset, POST /api/ai/describe returns 503.
GEMINI_API_KEY=

# Razorpay (India). Key id is safe client-side; secret + webhook secret stay
# server-only. Without these, the checkout hides the Razorpay option.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SkyDo bank-wire collection (international). SkyDo has no self-serve API —
# these are the virtual account details SkyDo/your bank issues per currency;
# paste them in once provisioned. A currency with its account number blank
# stays hidden at checkout.
SKYDO_USD_BANK_NAME=
SKYDO_USD_ACCOUNT_HOLDER=
SKYDO_USD_ROUTING_NUMBER=
SKYDO_USD_ACCOUNT_NUMBER=
SKYDO_GBP_BANK_NAME=
SKYDO_GBP_ACCOUNT_HOLDER=
SKYDO_GBP_SORT_CODE=
SKYDO_GBP_ACCOUNT_NUMBER=
SKYDO_EUR_BANK_NAME=
SKYDO_EUR_ACCOUNT_HOLDER=
SKYDO_EUR_IBAN=
SKYDO_EUR_BIC=
# Placeholder for a future real SkyDo webhook (see routes/payments/skydo.js).
SKYDO_WEBHOOK_SECRET=

# Outbound mail (Resend, free 3k/mo) — order confirmations + email OTP.
# Without these, mail is skipped and email OTP returns 503.
RESEND_API_KEY=
MAIL_FROM=EtherStar Jewels <orders@example.com>

